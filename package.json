{
  "name": "basketball-coaching-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static coaching site: Google Sheet stats tracker and play diagram builder. No dependencies, no build step.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8000",
    "build:plays": "node tools/build-plays-index.mjs",
    "build": "node tools/build-plays-index.mjs && node tools/build-site.mjs",
    "build:site": "node tools/build-site.mjs"
  },
  "license": "MIT"
}
